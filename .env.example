OPENCODE_GO_API_KEY=tu_api_key_de_opencode_go_aqui
NOTION_API_KEY=secret_tu_api_key_de_notion_aqui
APP_USER=admin
APP_PASS=admin
SESSION_SECRET=tu_secreto_para_sesiones
PORT=3012
OCR_MODEL=gemini-3.5-flash-lite,mimo-v2.5

# Entorno de despliegue. Ver AGENTS.md para la matriz completa.
#   local       - desarrollo en la maquina local (sin PM2, npm run dev)
#   servidor    - despliegue en el servidor (con PM2)
# DESPLIEGUE solo se lee cuando ENTORNO=servidor:
#   produccion  - pm2 restart tareaqxxi
#   desarrollo  - pm2 con node --watch
ENTORNO=local
DESPLIEGUE=produccion
